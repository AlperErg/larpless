<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap7="http://schemas.microsoft.com/appx/manifest/uap/windows10/7"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap7 rescap">

  <Identity
    Name="GarciaIgelmo.LarpLess"
    Publisher="CN=C46A4420-229A-4946-9836-AB6A1014CE96"
    Version="0.1.1.0" />

  <Properties>
    <DisplayName>LarpLess</DisplayName>
    <PublisherDisplayName>Garcia Igelmo</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 19041 (Windows 10 2004): FLScreenCapture hides LarpLess from its own screenshots with
         WDA_EXCLUDEFROMCAPTURE, which older builds don't have. Desktop only (runFullTrust Win32 app). -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="LarpLess"
        Description="LarpLess tracks your study sessions and shows where the time actually went. It checks your screen and webcam on your own PC to tell whether you are studying, which subject, or distracted, then sums up each session with focus time, streaks and Pomodoro breaks. Screenshots and camera frames never leave your computer."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Images\SplashScreen.png" BackgroundColor="#F3F5F8" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <uap7:Capability Name="globalMediaControl" />
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="webcam" />
  </Capabilities>
</Package>
