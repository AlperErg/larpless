<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="react-native" value="https://pkgs.dev.azure.com/ms/react-native/_packaging/react-native-public/nuget/v3/index.json" />
    <add key="Nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <!-- The react-native feed answers 401 for packages it doesn't mirror, which fails the whole restore.
       The longest matching pattern wins, so ONNX Runtime comes only from nuget.org; everything else is unchanged. -->
  <packageSourceMapping>
    <packageSource key="react-native">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Nuget.org">
      <package pattern="*" />
      <package pattern="Microsoft.ML.OnnxRuntime*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
