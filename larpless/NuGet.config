<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="react-native" value="https://pkgs.dev.azure.com/ms/react-native/_packaging/react-native-public/nuget/v3/index.json" />
    <add key="Nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!--
    The react-native feed proxies nuget.org, but it answers anonymous requests for packages it hasn't cached
    yet (Microsoft.ML.OnnxRuntime on a clean CI runner) with 401, and NuGet fails the restore on a 401 from
    any source (NU1301). Your own PC builds anyway because ~/.nuget/packages already holds them. So only
    react-native-windows' own packages may come from that feed (or nuget.org, which has the released ones);
    everything else comes from nuget.org. The most specific pattern wins, so the RNW patterns are listed
    under both sources.
  -->
  <packageSourceMapping>
    <packageSource key="Nuget.org">
      <package pattern="*" />
      <package pattern="Microsoft.ReactNative" />
      <package pattern="Microsoft.ReactNative.*" />
      <package pattern="Microsoft.JavaScript.Hermes" />
    </packageSource>
    <packageSource key="react-native">
      <package pattern="Microsoft.ReactNative" />
      <package pattern="Microsoft.ReactNative.*" />
      <package pattern="Microsoft.JavaScript.Hermes" />
    </packageSource>
  </packageSourceMapping>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
