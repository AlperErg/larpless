{
  "name": "LarpLess",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "macos": "react-native run-macos",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "windows": "npx @react-native-community/cli run-windows",
    "bundle:windows": "react-native bundle --platform windows --dev false --entry-file index.js --bundle-output windows/LarpLess/Bundle/index.windows.bundle --assets-dest windows/LarpLess/Bundle",
    "test:windows": "jest --config jest.config.windows.js",
    "postinstall": "node scripts/patch-rnsvg-windows.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.3",
    "date-fns": "^4.4.0",
    "lucide-react-native": "^1.55.0",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "react-native-macos": "^0.81.9",
    "react-native-svg": "^15.15.5",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-windows": "0.81.36",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@electric-sql/pglite": "^0.5.8",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.6",
    "@react-native/eslint-config": "0.81.6",
    "@react-native/metro-config": "0.81.6",
    "@react-native/typescript-config": "0.81.6",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.4",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3",
    "@rnx-kit/jest-preset": "^0.1.17"
  },
  "engines": {
    "node": ">=22"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "LarpLess",
      "namespace": "LarpLess",
      "template": "cpp-app"
    }
  }
}
